# Copy to commercial/.env.local and fill YOUR OWN one-time secrets. Do not commit.
BEE_BIND_HOST=127.0.0.1
BEE_PORT=8443
BEE_PUBLIC_ORIGIN=https://127.0.0.1:8443
BEE_ADMIN_PASSWORD_SCRYPT=
BEE_ADMIN_TOTP_SECRET=
# Windows PFX exported from a localhost self-signed certificate:
BEE_HTTPS_PFX_FILE=
BEE_HTTPS_PFX_PASSWORD=
# Optional, default commercial/qa-data/beekeepy-qa.sqlite (isolated new file)
# BEE_DB_FILE=
# Production integrations are disabled unless explicitly configured.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_IDS=
